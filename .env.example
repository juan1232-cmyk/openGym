# Copy this to .env before `docker compose up` (README > Configuration has the full table).

# Hostname passkeys are bound to. Must match the host you actually browse to --
# a passkey registered under one RP_ID will not authenticate under another.
RP_ID=localhost

# Full URL the app is served from. http://localhost:8080 for local-only use;
# an https:// URL is required for passkeys to work from your phone over the internet
# (see docs/SELF_HOSTING.md).
ORIGIN=http://localhost:8080

# Host port for the web UI (nginx). Change if 8080 is taken.
WEB_PORT=8080

# Name shown in the OS passkey prompt ("Save a passkey for <RP_NAME>?").
RP_NAME=openGym

# Comma-separated user ids that get the admin dashboard. Leave empty and a fresh
# instance stays open with no admin. Find your user id in Settings once you've
# created a profile.
ADMIN_UIDS=

# Require an invite code (generated by an admin) to create a new profile. Off by default.
INVITE_ONLY=
